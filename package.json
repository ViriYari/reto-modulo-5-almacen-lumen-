{
  "name": "almacen-lumen",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda de práctica para el reto de QA cloud-native: catálogo reproducible, pedidos y quality gates.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "datos": "node datos/generar-datos.js",
    "start": "node app-tienda/server.js",
    "test": "node --test test/*.test.js",
    "smoke": "node pipeline/smoke-test.js",
    "load": "node pipeline/load-test.js",
    "load:green": "node pipeline/load-test.js --sla-p95 800 --out docs/evidencias/load-green.json",
    "load:red": "node pipeline/load-test.js --sla-p95 1 --out docs/evidencias/load-red.json",
    "pact:consumer": "node pact/consumer.test.js",
    "pact:provider": "node pact/provider.verify.js",
    "e2e": "pytest e2e"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^15.0.1"
  }
}
