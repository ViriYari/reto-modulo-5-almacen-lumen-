# Copia este archivo a .env solo en tu máquina. No pongas secretos en el repositorio.
PORT=4789
BASE_URL=http://127.0.0.1:4789

# Quality gate de carga. 800 ms es el SLA del reto. Bajarlo a 1 demuestra el gate en rojo.
SLA_P95_MS=800
SLA_ERROR_MAX=0.01

# Sauce Labs. Vacío = la etapa de nube queda en demo guiada.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1

# Azure Container Registry. Vacío = el deploy no publica la imagen.
ACR_NAME=
ACR_LOGIN_SERVER=
